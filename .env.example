# ── Project inquiry delivery ──────────────────────────────────────────────
# Both channels are optional and independent. With neither set, /api/inquiry
# returns 503 `not_configured` and the form falls back to showing the direct
# Telegram and email links — it never reports a fake success.

# Email via Resend (https://resend.com)
RESEND_API_KEY=
INQUIRY_FROM="wlans <noreply@yourdomain.com>"   # must be a verified sender
INQUIRY_TO=hello@wlans.uz

# Telegram bot. Create with @BotFather, then get the chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates after messaging the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Site identity ──────────────────────────────────────────────────────────
# Absolute origin, no trailing slash. Used for canonical URLs, hreflang, the
# sitemap and Open Graph. Wrong here means Google indexes the wrong host and
# Telegram fetches previews from it, so it must be set in production.
NEXT_PUBLIC_SITE_URL=https://wlans.uz
